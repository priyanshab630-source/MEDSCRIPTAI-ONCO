# ---- LLM (optional) -------------------------------------------------------
# Without a key the pipeline uses deterministic rule-based reasoning.
# Get one at https://dashboard.sarvam.ai  (any OpenAI-compatible endpoint works)
SARVAM_API_KEY=
LLM_BASE_URL=https://api.sarvam.ai/v1/chat/completions
LLM_MODEL=sarvam-m

# ---- Orchestration engine -------------------------------------------------
# 1 = real LangGraph StateGraph, 0 = built-in dependency-free shim
USE_LANGGRAPH=0

# ---- Knowledge graph (optional) -------------------------------------------
# Leave blank to use data/kg_triples.json (see docker-compose.yml for a local Neo4j)
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---- Observability --------------------------------------------------------
TRACE_ENABLED=1
TRACE_DIR=traces
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medscriptai-onco
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Decision policy ------------------------------------------------------
ABSTAIN_THRESHOLD=0.55
SUPPORT_THRESHOLD=0.30
MAX_ADAPTIVE_LOOPS=2
